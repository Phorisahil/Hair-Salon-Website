{
  "name": "hair-salon-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:import:sqlite": "node scripts/import-sqlite-to-postgres.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "admin:setup": "tsx scripts/admin-account.ts create",
    "admin:reset-password": "tsx scripts/admin-account.ts reset-password",
    "admin:update-credentials": "tsx scripts/admin-account.ts update-credentials",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^6.16.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
